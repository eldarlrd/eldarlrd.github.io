{
  "name": "eldarlrd.github.io",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "keywords": [
    "personal",
    "retro"
  ],
  "description": "A simple personal website",
  "repository": "github:eldarlrd/eldarlrd.github.io",
  "homepage": "https://eldarlrd.is-a.dev",
  "author": "Eldar Pashazade <eldarlrd@pm.me> (https://eldarlrd.is-a.dev)",
  "scripts": {
    "dev": "vite --open",
    "bundle": "tsc && vite build",
    "serve": "vite preview",
    "check": "bun test __tests__/**/*.{test,spec}.{ts,tsx} --randomize",
    "check:w": "bun check --watch",
    "cover": "bun check --coverage",
    "deployer": "bun bundle && gh-pages -b prod -m 'build(prod): deployment' -d dist",
    "fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
    "orphans": "knip --cache --no-exit-code"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fontsource-variable/handjet": "^5.3.0",
    "@happy-dom/global-registrator": "^20.12.0",
    "@phosphor-icons/webcomponents": "^2.1.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.4.0",
    "gh-pages": "^6.3.0",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
